# Copy to .env (git-ignored) and adjust. Values here are for local development only.

# Nexus credentials: needed to build the image (uaa-client comes from the private Nexus)
NEXUS_USERNAME=
NEXUS_PASSWORD=

# Base image registry: company mirror by default; use docker.io/library outside the company network
BASE_IMAGE_REGISTRY=hub.bmicc.ir/library

SPRING_PROFILES_ACTIVE=prod
CARD_PORT=8007

# Local infrastructure passwords
ORACLE_ADMIN_PASSWORD=oracle_local
CARD_DB_PASSWORD=card_local
REDIS_PASSWORD=redis_local
VAULT_TOKEN=root

# External systems
SSM_BASE_URL=https://192.168.104.10:8018
PARTY_BASE_URL=http://192.168.104.20:8001
UAA_BASE_URL=https://stage-sbu-panel.bmicc.ir
